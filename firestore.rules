rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default rule: Deny all reads and writes unless explicitly allowed
    match /{document=**} {
      allow read: if true; // Let the public read the card database
      allow write: if false; // Deny general writes completely
    }

    // SAFER: Only logged-in users can write their own data
    match /contributors/{userId} {
      // Allows anyone to read (or restrict to logged-in)
      allow read: if true; 
      // Only the user who is logged in and whose UID matches the document ID can write
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Example for a cards collection:
    // Only logged in users can create/edit cards, 
    // and maybe they can only edit their own creations.
    match /cards/{cardId} {
      allow read: if true;
      // Alternatively, let ANY logged in contributor write:
      allow write: if request.auth != null; 
    }
  }
}
